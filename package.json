{
  "name": "solo-vault-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.908.0",
    "@aws-sdk/client-iam": "^3.908.0",
    "@aws-sdk/client-lambda": "^3.908.0",
    "@aws-sdk/client-s3": "^3.908.0",
    "@aws-sdk/client-secrets-manager": "^3.908.0",
    "@aws-sdk/s3-request-presigner": "^3.908.0",
    "adm-zip": "^0.5.16",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "scripts": {
    "iac": "node ./node_modules/tsx/dist/cli.mjs infra/scripts/deploy.ts",
    "iac:pipeline": "node ./node_modules/tsx/dist/cli.mjs infra/scripts/deploy-pipeline.ts",
    "iac:cognito": "node ./node_modules/tsx/dist/cli.mjs infra/scripts/deploy-cognito.ts",
    "iac:apigw": "node ./node_modules/tsx/dist/cli.mjs infra/scripts/deploy-api-gateway.ts",
    "deploy": "npm run iac -- --env dev",
    "deploy:staging": "npm run iac -- --env staging",
    "deploy:prod": "npm run iac -- --env prod",
    "deploy:pipeline": "npm run iac:pipeline -- --env dev",
    "deploy:pipeline:staging": "npm run iac:pipeline -- --env staging",
    "deploy:pipeline:prod": "npm run iac:pipeline -- --env prod",
    "deploy:cognito": "npm run iac:cognito -- --env dev",
    "deploy:cognito:staging": "npm run iac:cognito -- --env staging",
    "deploy:cognito:prod": "npm run iac:cognito -- --env prod",
    "deploy:apigw": "npm run iac:apigw -- --env dev",
    "deploy:apigw:staging": "npm run iac:apigw -- --env staging",
    "deploy:apigw:prod": "npm run iac:apigw -- --env prod",
    "destroy": "npm run iac -- --action destroy --env dev",
    "destroy:staging": "npm run iac -- --action destroy --env staging",
    "destroy:prod": "npm run iac -- --action destroy --env prod",
    "destroy:pipeline": "npm run iac:pipeline -- --action destroy --env dev --confirm-destroy solo-vault",
    "destroy:pipeline:staging": "npm run iac:pipeline -- --action destroy --env staging --confirm-destroy solo-vault",
    "destroy:pipeline:prod": "npm run iac:pipeline -- --action destroy --env prod --confirm-destroy solo-vault",
    "destroy:cognito": "npm run iac:cognito -- --action destroy --env dev",
    "destroy:cognito:staging": "npm run iac:cognito -- --action destroy --env staging",
    "destroy:cognito:prod": "npm run iac:cognito -- --action destroy --env prod",
    "destroy:apigw": "npm run iac:apigw -- --action destroy --env dev",
    "destroy:apigw:staging": "npm run iac:apigw -- --action destroy --env staging",
    "destroy:apigw:prod": "npm run iac:apigw -- --action destroy --env prod",
    "iac:vault-crud": "node ./node_modules/tsx/dist/cli.mjs infra/scripts/deploy-vault-crud.ts",
    "deploy:vault-crud": "npm run iac:vault-crud -- --env dev",
    "deploy:vault-crud:staging": "npm run iac:vault-crud -- --env staging",
    "deploy:vault-crud:prod": "npm run iac:vault-crud -- --env prod",
    "destroy:vault-crud": "npm run iac:vault-crud -- --action destroy --env dev",
    "destroy:vault-crud:staging": "npm run iac:vault-crud -- --action destroy --env staging",
    "destroy:vault-crud:prod": "npm run iac:vault-crud -- --action destroy --env prod",
    "iac:storage": "node ./node_modules/tsx/dist/cli.mjs infra/scripts/deploy-storage.ts",
    "deploy:storage": "npm run iac:storage -- --env dev",
    "deploy:storage:staging": "npm run iac:storage -- --env staging",
    "deploy:storage:prod": "npm run iac:storage -- --env prod",
    "destroy:storage": "npm run iac:storage -- --action destroy --env dev",
    "destroy:storage:staging": "npm run iac:storage -- --action destroy --env staging",
    "destroy:storage:prod": "npm run iac:storage -- --action destroy --env prod",
    "migrate": "node ./node_modules/tsx/dist/cli.mjs infra/scripts/migrate.ts",
    "migrate:dev": "npm run migrate -- --env dev",
    "migrate:staging": "npm run migrate -- --env staging",
    "migrate:prod": "npm run migrate -- --env prod"
  }
}
