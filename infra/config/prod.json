  "stacks": {
    "shared-network": {
      "stack_name": "solo-vault-shared-network-prod",
      "parameters": {
        "VpcCidr": "10.30.0.0/16",
        "PrivateSubnetACidr": "10.30.1.0/24",
        "PrivateSubnetBCidr": "10.30.2.0/24"
      }
    },
    "secrets": {
      "stack_name": "solo-vault-secrets-prod",
      "parameters": {
        "DbUsername": "solovault"
      }
    },
    "rds": {
      "stack_name": "solo-vault-rds-prod",
      "parameters": {
        "DbName": "solovault",
        "DbInstanceClass": "db.t3.small",
        "DbEngineVersion": "15.7",
        "DbAllocatedStorage": "50",
        "DbBackupRetentionDays": "14",
        "DbDeletionProtection": "true",
        "DbMultiAz": "false"
      }
    },
    "network-endpoints": {
      "stack_name": "solo-vault-network-endpoints-prod",
      "parameters": {}
    },
    "lambda-artifacts": {
      "stack_name": "solo-vault-lambda-artifacts-prod",
      "parameters": {}
    }
  }
